# --- Database ---
# Get this from your Neon project dashboard (Connection Details -> Pooled connection)
DATABASE_URL=postgresql://user:passwd@ep-xxxx-pooler.region.aws.neon.tech/attendqr?sslmode=require

# --- Auth ---
# Random long strings. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
QR_SECRET=replace-with-a-different-long-random-string

# --- App ---
# Public URL of the deployed app (used to build the URL encoded inside the QR code)
NEXT_PUBLIC_APP_URL=https://app.vercel.app/
# How long each QR code stays valid, in seconds (45-60 recommended)
QR_ROTATE_SECONDS=45

# --- Seed script (scripts/seed-admin.ts) ---
SEED_TEACHER_NAME="Admin Teacher"
SEED_TEACHER_EMAIL=admin@school.edu
SEED_TEACHER_PASSWORD=change-this-password
